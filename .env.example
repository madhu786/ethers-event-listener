# RPC endpoint: http(s) JSON-RPC or ws(s) WebSocket
RPC_URL=http://127.0.0.1:8545

# Contract whose events should be indexed
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Path to a JSON file containing the contract ABI (array of fragments)
CONTRACT_ABI=./examples/erc20-abi.json

# Watch several contracts at once (takes precedence over CONTRACT_ADDRESS /
# CONTRACT_ABI above): a JSON array of { address, abi } entries, where abi
# is a path to a JSON ABI file. Each contract gets its own listener; all
# events land in the same store and stay queryable per address (?address=).
# CONTRACTS=[{"address":"0x0000000000000000000000000000000000000000","abi":"./examples/erc20-abi.json"}]

# First block to backfill (omit to start from the latest block)
FROM_BLOCK=

# Polling cadence in milliseconds
POLL_INTERVAL_MS=5000

# REST API port
PORT=3000

# SQLite file for persistent storage (omit for in-memory only).
# Requires Node 24+ (node:sqlite is built into the runtime).
DATABASE_PATH=./events.db
